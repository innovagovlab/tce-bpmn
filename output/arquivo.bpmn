<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Mapeamento do Trabalho" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Analista da Ouvidoria">
        <bpmn:flowNodeRef>ouvidoria_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_gateway1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_task8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ouvidoria_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Setor Responsável pelo Serviço">
        <bpmn:flowNodeRef>ouvidoria_task3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ouvidoria_start" name="Início da Manutenção">
      <bpmn:outgoing>ouvidoria_start-ouvidoria_task1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ouvidoria_task1" name="Iniciar Manutenção">
      <bpmn:incoming>ouvidoria_start-ouvidoria_task1</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task1-ouvidoria_task2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ouvidoria_task2" name="Comunicar Mudança">
      <bpmn:incoming>ouvidoria_task1-ouvidoria_task2</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task2-ouvidoria_task3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ouvidoria_task3" name="Solicitar Alteração">
      <bpmn:incoming>ouvidoria_task2-ouvidoria_task3</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task3-ouvidoria_task4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ouvidoria_task4" name="Analisar Solicitação">
      <bpmn:incoming>ouvidoria_task3-ouvidoria_task4</bpmn:incoming>
      <bpmn:incoming>ouvidoria_task5-ouvidoria_task4</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task4-ouvidoria_gateway1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ouvidoria_gateway1" name="Solicitação Completa?">
      <bpmn:incoming>ouvidoria_task4-ouvidoria_gateway1</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_gateway1-ouvidoria_task5</bpmn:outgoing>
      <bpmn:outgoing>ouvidoria_gateway1-ouvidoria_task6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ouvidoria_task5" name="Solicitar Informações">
      <bpmn:incoming>ouvidoria_gateway1-ouvidoria_task5</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task5-ouvidoria_task4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ouvidoria_task6" name="Realizar Alteração">
      <bpmn:incoming>ouvidoria_gateway1-ouvidoria_task6</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task6-ouvidoria_task7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="ouvidoria_task7" name="Publicar Alteração">
      <bpmn:incoming>ouvidoria_task6-ouvidoria_task7</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task7-ouvidoria_task8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="ouvidoria_task8" name="Comunicar Conclusão">
      <bpmn:incoming>ouvidoria_task7-ouvidoria_task8</bpmn:incoming>
      <bpmn:outgoing>ouvidoria_task8-ouvidoria_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ouvidoria_end" name="Manutenção Concluída">
      <bpmn:incoming>ouvidoria_task8-ouvidoria_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ouvidoria_start-ouvidoria_task1" sourceRef="ouvidoria_start" targetRef="ouvidoria_task1" />
    <bpmn:sequenceFlow id="ouvidoria_task1-ouvidoria_task2" sourceRef="ouvidoria_task1" targetRef="ouvidoria_task2" />
    <bpmn:sequenceFlow id="ouvidoria_task2-ouvidoria_task3" sourceRef="ouvidoria_task2" targetRef="ouvidoria_task3" />
    <bpmn:sequenceFlow id="ouvidoria_task3-ouvidoria_task4" sourceRef="ouvidoria_task3" targetRef="ouvidoria_task4" />
    <bpmn:sequenceFlow id="ouvidoria_task4-ouvidoria_gateway1" sourceRef="ouvidoria_task4" targetRef="ouvidoria_gateway1" />
    <bpmn:sequenceFlow id="ouvidoria_task5-ouvidoria_task4" sourceRef="ouvidoria_task5" targetRef="ouvidoria_task4" />
    <bpmn:sequenceFlow id="ouvidoria_gateway1-ouvidoria_task5" name="Não" sourceRef="ouvidoria_gateway1" targetRef="ouvidoria_task5" />
    <bpmn:sequenceFlow id="ouvidoria_task6-ouvidoria_task7" sourceRef="ouvidoria_task6" targetRef="ouvidoria_task7" />
    <bpmn:sequenceFlow id="ouvidoria_gateway1-ouvidoria_task6" name="Sim" sourceRef="ouvidoria_gateway1" targetRef="ouvidoria_task6" />
    <bpmn:sequenceFlow id="ouvidoria_task7-ouvidoria_task8" sourceRef="ouvidoria_task7" targetRef="ouvidoria_task8" />
    <bpmn:sequenceFlow id="ouvidoria_task8-ouvidoria_end" sourceRef="ouvidoria_task8" targetRef="ouvidoria_end" />
  </bpmn:process>
