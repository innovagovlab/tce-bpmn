API_KEY=
AZURE_ENDPOINT=
DEPLOYMENT_NAME=
API_VERSION=
CHAT_COMPLETION_RETRIES=3   # Valor padrão: 3

# Docker SQL Server (SQL Server 2022 / v16)
# Regras do SQL Server: mínimo 8 caracteres, deve conter maiúscula, minúscula, número e símbolo.
MSSQL_SA_PASSWORD=Senha123!

# Auth / Login
APP_NAME=BPMN Generator
OTP_EXPIRATION_MINUTES=15
TEMP_PASSWORD_LENGTH=16

# Database (SQL Server)
DB_SERVER=localhost,1433
DB_NAME=tce_bpmn
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_CERT=yes

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail
SMTP_PASSWORD=genarate_app_password_in_google_account
SMTP_FROM=your_gmail
SMTP_TLS=true
SMTP_SSL=false
